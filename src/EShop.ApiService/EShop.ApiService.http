@ApiService_HostAddress = http://localhost:5544

GET {{ApiService_HostAddress}}/weatherforecast/
Accept: application/json

###

### Get all products
GET {{ApiService_HostAddress}}/api/products
Accept: application/json

###

### Get product by Id
GET {{ApiService_HostAddress}}/api/products/1
Accept: application/json

###

### Create a new product
POST {{ApiService_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "Portable SSD 1TB",
  "description": "High-speed portable external SSD with USB-C connectivity.",
  "price": 109.99,
  "imageUri": "https://example.com/images/portable-ssd.png"
}

###

### Update an existing product
PUT {{ApiService_HostAddress}}/api/products/1
Content-Type: application/json

{
  "name": "Wireless Mouse Pro",
  "description": "Ergonomic wireless mouse with adjustable DPI settings and silent clicks.",
  "price": 29.99,
  "imageUri": "https://example.com/images/wireless-mouse-pro.png"
}

###

### Delete a product
DELETE {{ApiService_HostAddress}}/api/products/5

###

### Get all orders
GET {{ApiService_HostAddress}}/api/orders
Accept: application/json

###

### Get order by Id
GET {{ApiService_HostAddress}}/api/orders/1
Accept: application/json

###

### Create a new order
POST {{ApiService_HostAddress}}/api/orders
Content-Type: application/json

{
  "customerName": "Noah Williams",
  "orderDate": "2026-10-01T00:00:00",
  "totalAmount": 199.97,
  "status": "Processing"
}

###

### Update an existing order
PUT {{ApiService_HostAddress}}/api/orders/1
Content-Type: application/json

{
  "customerName": "Ava Thompson",
  "orderDate": "2026-09-15T00:00:00",
  "totalAmount": 114.98,
  "status": "Delivered"
}

###

### Delete an order
DELETE {{ApiService_HostAddress}}/api/orders/2

###

@CustomerId = 5f45aad3-53b1-4b20-a416-6d8e7d91d87e

### Get all customers
GET {{ApiService_HostAddress}}/api/customers
Accept: application/json

###

### Get customer by Id
GET {{ApiService_HostAddress}}/api/customers/{{CustomerId}}
Accept: application/json

###

### Create a new customer
POST {{ApiService_HostAddress}}/api/customers
Content-Type: application/json

{
  "firstName": "Noah",
  "lastName": "Williams",
  "email": "noah.williams@example.com"
}

###

### Update an existing customer
PUT {{ApiService_HostAddress}}/api/customers/{{CustomerId}}
Content-Type: application/json

{
  "firstName": "Ava",
  "lastName": "Thompson",
  "email": "ava.thompson.updated@example.com"
}

###

### Delete a customer
DELETE {{ApiService_HostAddress}}/api/customers/{{CustomerId}}

###

@CartCustomerName = Ava%20Thompson

### Get the cart before adding items
GET {{ApiService_HostAddress}}/api/carts/{{CartCustomerName}}
Accept: application/json

###

### Add a product to the cart
POST {{ApiService_HostAddress}}/api/carts/{{CartCustomerName}}/items
Content-Type: application/json

{
  "productId": 1,
  "quantity": 1
}

###

### Add the same product to increase its quantity
POST {{ApiService_HostAddress}}/api/carts/{{CartCustomerName}}/items
Content-Type: application/json

{
  "productId": 1,
  "quantity": 2
}

###

### Remove a product line from the cart
DELETE {{ApiService_HostAddress}}/api/carts/{{CartCustomerName}}/items/1

###

### Add a product before checkout
POST {{ApiService_HostAddress}}/api/carts/{{CartCustomerName}}/items
Content-Type: application/json

{
  "productId": 2,
  "quantity": 1
}

###

### Checkout the cart
POST {{ApiService_HostAddress}}/api/carts/{{CartCustomerName}}/checkout

###

### Confirm the cart is cleared
GET {{ApiService_HostAddress}}/api/carts/{{CartCustomerName}}
Accept: application/json

###

### Confirm the order was created
GET {{ApiService_HostAddress}}/api/orders/3
Accept: application/json

###