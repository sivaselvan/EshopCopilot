@ApiService_HostAddress = http://localhost:5544

GET {{ApiService_HostAddress}}/weatherforecast/
Accept: application/json

###

### Get all products
GET {{ApiService_HostAddress}}/api/products
Accept: application/json

###

### Get product by Id
GET {{ApiService_HostAddress}}/api/products/1
Accept: application/json

###

### Create a new product
POST {{ApiService_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "Portable SSD 1TB",
  "description": "High-speed portable external SSD with USB-C connectivity.",
  "price": 109.99,
  "imageUri": "https://example.com/images/portable-ssd.png"
}

###

### Update an existing product
PUT {{ApiService_HostAddress}}/api/products/1
Content-Type: application/json

{
  "name": "Wireless Mouse Pro",
  "description": "Ergonomic wireless mouse with adjustable DPI settings and silent clicks.",
  "price": 29.99,
  "imageUri": "https://example.com/images/wireless-mouse-pro.png"
}

###

### Delete a product
DELETE {{ApiService_HostAddress}}/api/products/5

###

### Get all orders
GET {{ApiService_HostAddress}}/api/orders
Accept: application/json

###

### Get order by Id
GET {{ApiService_HostAddress}}/api/orders/1
Accept: application/json

###

### Create a new order
POST {{ApiService_HostAddress}}/api/orders
Content-Type: application/json

{
  "customerName": "Noah Williams",
  "orderDate": "2026-10-01T00:00:00",
  "totalAmount": 199.97,
  "status": "Processing"
}

###

### Update an existing order
PUT {{ApiService_HostAddress}}/api/orders/1
Content-Type: application/json

{
  "customerName": "Ava Thompson",
  "orderDate": "2026-09-15T00:00:00",
  "totalAmount": 114.98,
  "status": "Delivered"
}

###

### Delete an order
DELETE {{ApiService_HostAddress}}/api/orders/2

